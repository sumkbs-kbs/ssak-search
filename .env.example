# ═══════════════════════════════════════════════════════════════
# 로컬 개발 환경 설정 — Search Engine API
# ═══════════════════════════════════════════════════════════════
#
# 사용법:
#   1. 이 파일을 .env로 복사: cp .env.example .env
#   2. .env 파일에 값을 채움
#   3. ./scripts/start-local.sh 실행
#
# 참고: API 키 없이도 검색 엔진의 모든 핵심 기능은 무료로 동작합니다.
# 아래 변수들은 성능 향상을 위한 OPTIONAL 설정입니다.

# ═══════════════════════════════════════════════════════════════
# [권장] 로컬 AI 모델 (Ollama)
# ═══════════════════════════════════════════════════════════════
# Ollama가 설치되어 있고, 원하는 모델이 pull되어 있어야 합니다.
# 설치: brew install ollama
# 답변 생성(채팅) 모델:
#   ollama pull hf.co/HauhauCS/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive:Q6_K_P
# 임베딩(자체 인덱스 검색) 모델 — 로컬에서 인덱스를 쓸 때 필수:
#   ollama pull nomic-embed-text   (~270MB, 768차원)
# 기본값: http://localhost:11434 (명시적으로 설정 필요)
OLLAMA_BASE_URL=http://localhost:11434

# ═══════════════════════════════════════════════════════════════
# [권장] OpenRouter 무료 LLM 모델 (답변 생성)
# ═══════════════════════════════════════════════════════════════
# OpenRouter는 DeepSeek R1, Qwen3 480B, Llama 4 등을 무료로 제공합니다.
# Workers AI와 달리 외부 API 호출이므로 CPU 시간을 소모하지 않아
# Cloudflare 무료 플랜에서도 답변 생성이 정상 작동합니다.
# 무료 API 키 발급: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ═══════════════════════════════════════════════════════════════
# [선택] SearXNG 자체 호스팅 검색 백엔드
# ═══════════════════════════════════════════════════════════════
# SearXNG를 설정하면 DuckDuckGo 스크래핑을 대체합니다.
# 설치: docker/searxng/ 참조
# SEARXNG_URL=http://localhost:8888
# SEARXNG_API_KEY=

# ═══════════════════════════════════════════════════════════════
# [선택] 외부 AI 모델 API 키
# ═══════════════════════════════════════════════════════════════
# OPENAI_API_KEY=sk-...       # GPT-4o-mini 답변 생성 (~$0.36/1만회)
# ANTHROPIC_API_KEY=sk-ant-... # Claude 3.5 Haiku 답변 생성

# ═══════════════════════════════════════════════════════════════
# [선택] Brave Search API
# ═══════════════════════════════════════════════════════════════
# Brave Search API를 사용한 ToS-safe 검색 (무료 티어 50 req/s)
# https://brave.com/search/api/
# BRAVE_API_KEY=

# ═══════════════════════════════════════════════════════════════
# [선택] Jina Reader API
# ═══════════════════════════════════════════════════════════════
# 고급 콘텐츠 추출 (미설정 시 HTMLRewriter 폴백)
# JINA_API_KEY=jina_...

# ═══════════════════════════════════════════════════════════════
# [선택] API 인증 키
# ═══════════════════════════════════════════════════════════════
# 설정 시 모든 /api/* 요청에 Authorization: Bearer <key> 필요
# SEARCH_API_KEY=

# ═══════════════════════════════════════════════════════════════
# [선택] Cloudflare Pages Secrets (로컬 개발용)
# ═══════════════════════════════════════════════════════════════
# SENTRY_DSN=sentry_...       # Sentry APM (선택)
# ENVIRONMENT=development      # 환경 이름

# ═══════════════════════════════════════════════════════════════
# [선택] 캐시 설정 (초 단위)
# ═══════════════════════════════════════════════════════════════
# CACHE_TTL_GENERAL=1800      # 일반 검색 캐시 (30분)
# CACHE_TTL_NEWS=300           # 뉴스 검색 캐시 (5분)
