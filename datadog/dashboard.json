        ]
      },
      "layout": { "x": 12, "y": 4, "width": 3, "height": 2 }
    },
    {
      "id": 7,
      "definition": {
        "title": "Errors (24h)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "formulas": [{ "formula": "query1" }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service (level:error OR level:critical)",
                "indexes": ["*"],
                "compute": { "aggregation": "count" }
              }
            ],
            "response_format": "scalar"
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": { "x": 15, "y": 4, "width": 3, "height": 2 }
    },
    {
      "id": 8,
      "definition": {
        "title": "Active Endpoints",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "formulas": [{ "formula": "query1" }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @message:\"Request completed\"",
                "indexes": ["*"],
                "compute": { "aggregation": "count" }
              }
            ],
            "response_format": "scalar"
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": { "x": 18, "y": 4, "width": 3, "height": 2 }
    },
    {
      "id": 9,
      "definition": {
        "title": "Audit Events Over Time (24h)",
        "type": "timeseries",
        "requests": [
          {
            "formulas": [{ "formula": "query1", "alias": "Auth Failures" }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @audit:\"true\" @eventType:\"auth_failure\"",
                "indexes": ["*"],
                "compute": { "aggregation": "count", "interval": 300000 },
                "group_by": []
              }
            ],
            "response_format": "timeseries",
            "style": { "palette": "red", "line_type": "solid", "line_width": "normal" },
            "display_type": "bars"
          },
          {
            "formulas": [{ "formula": "query2", "alias": "Rate Limit" }],
            "queries": [
              {
                "name": "query2",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @audit:\"true\" @eventType:\"rate_limit_exceeded\"",
                "indexes": ["*"],
                "compute": { "aggregation": "count", "interval": 300000 },
                "group_by": []
              }
            ],
            "response_format": "timeseries",
            "style": { "palette": "orange", "line_type": "solid", "line_width": "normal" },
            "display_type": "bars"
          },
          {
            "formulas": [{ "formula": "query3", "alias": "SSRF Attempts" }],
            "queries": [
              {
                "name": "query3",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @audit:\"true\" @eventType:\"ssrf_attempt\"",
                "indexes": ["*"],
                "compute": { "aggregation": "count", "interval": 300000 },
                "group_by": []
              }
            ],
            "response_format": "timeseries",
            "style": { "palette": "purple", "line_type": "solid", "line_width": "normal" },
            "display_type": "bars"
          }
        ],
        "yaxis": { "scale": "linear", "min": "auto", "max": "auto" },
        "legend_columns": ["avg", "min", "max", "value"],
        "legend_layout": "table",
        "markers": []
      },
      "layout": { "x": 0, "y": 6, "width": 12, "height": 4 }
    },
    {
      "id": 10,
      "definition": {
        "title": "Error Rate Over Time (24h)",
        "type": "timeseries",
        "requests": [
          {
            "formulas": [{ "formula": "query1", "alias": "Errors" }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service (level:error OR level:critical)",
                "indexes": ["*"],
                "compute": { "aggregation": "count", "interval": 300000 },
                "group_by": []
              }
            ],
            "response_format": "timeseries",
            "style": { "palette": "red", "line_type": "solid", "line_width": "normal" },
            "display_type": "bars"
          },
          {
            "formulas": [{ "formula": "query2", "alias": "Warnings" }],
            "queries": [
              {
                "name": "query2",
                "data_source": "logs",
                "query": "source:cloudflare service:$service level:warn",
                "indexes": ["*"],
                "compute": { "aggregation": "count", "interval": 300000 },
                "group_by": []
              }
            ],
            "response_format": "timeseries",
            "style": { "palette": "yellow", "line_type": "solid", "line_width": "normal" },
            "display_type": "bars"
          }
        ],
        "yaxis": { "scale": "linear", "min": "auto", "max": "auto" },
        "legend_columns": ["avg", "min", "max", "value"],
        "legend_layout": "table",
        "markers": []
      },
      "layout": { "x": 12, "y": 6, "width": 12, "height": 4 }
    },
    {
      "id": 11,
      "definition": {
        "title": "Top 10 Abusive IPs (24h)",
        "type": "toplist",
        "requests": [
          {
            "formulas": [{ "formula": "query1", "limit": { "count": 10, "order": "desc" } }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @audit:\"true\" (@eventType:\"auth_failure\" OR @eventType:\"rate_limit_exceeded\")",
                "indexes": ["*"],
                "compute": { "aggregation": "count" },
                "group_by": [{ "facet": "@actor", "limit": 10, "sort": { "aggregation": "count", "order": "desc" } }]
              }
            ],
            "response_format": "scalar"
          }
        ]
      },
      "layout": { "x": 0, "y": 10, "width": 6, "height": 4 }
    },
    {
      "id": 12,
      "definition": {
        "title": "Security Events by Type (24h)",
        "type": "pie",
        "requests": [
          {
            "formulas": [{ "formula": "query1", "limit": { "count": 10, "order": "desc" } }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @audit:\"true\"",
                "indexes": ["*"],
                "compute": { "aggregation": "count" },
                "group_by": [{ "facet": "@eventType", "limit": 10, "sort": { "aggregation": "count", "order": "desc" } }]
              }
            ],
            "response_format": "scalar"
          }
        ]
      },
      "layout": { "x": 6, "y": 10, "width": 6, "height": 4 }
    },
    {
      "id": 13,
      "definition": {
        "title": "Event Severity Distribution (24h)",
        "type": "pie",
        "requests": [
          {
            "formulas": [{ "formula": "query1", "limit": { "count": 10, "order": "desc" } }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @audit:\"true\"",
                "indexes": ["*"],
                "compute": { "aggregation": "count" },
                "group_by": [{ "facet": "@severity", "limit": 10, "sort": { "aggregation": "count", "order": "desc" } }]
              }
            ],
            "response_format": "scalar"
          }
        ]
      },
      "layout": { "x": 12, "y": 10, "width": 6, "height": 4 }
    },
    {
      "id": 14,
      "definition": {
        "title": "Recent Audit Events (last 20)",
        "type": "log_stream",
        "requests": [
          {
            "query": "source:cloudflare service:$service @audit:\"true\"",
            "columns": ["timestamp", "message", "auditEventType", "auditSeverity", "auditOutcome", "actor", "resource"],
            "indexes": ["*"]
          }
        ],
        "message_display": "expanded-md"
      },
      "layout": { "x": 0, "y": 14, "width": 24, "height": 6 }
    },
    {
      "id": 15,
      "definition": {
        "type": "note",
        "content": "## 📊 Summary & SLO Monitoring\n\n| Metric | Query | Target |\n|--------|-------|--------|\n| **Auth Failure Rate** | `@audit:\"true\" @eventType:\"auth_failure\"` | < 10/5min |\n| **Rate Limit Abuse** | `@audit:\"true\" @eventType:\"rate_limit_exceeded\"` | < 100/5min |\n| **SSRF Attempts** | `@audit:\"true\" @eventType:\"ssrf_attempt\"` | 0 (any = page) |\n| **Error Rate** | `(level:error OR level:critical)` | < 1% of requests |\n\nSee also: [Prometheus Grafana Dashboard](/grafana/dashboard.json) for real-time backend health metrics.\n\n---\n\n### Recommended Monitors\n\n| Monitor | Query | Threshold |\n|---------|-------|-----------|\n| Auth Failures Spike | `@audit:\"true\" @eventType:\"auth_failure\"` | > 10 in 5m → Warning |\n| SSRF Attempt | `@audit:\"true\" @severity:\"critical\"` | > 0 → Critical (page) |\n| Rate Limit Abuse | `@audit:\"true\" @eventType:\"rate_limit_exceeded\"` | > 100 in 5m → Warning |\n| High Error Rate | `(level:error OR level:critical)` | > 50 in 5m → Warning |\n\n---\n\n*Dashboard generated by Search Engine API — AUDIT.md for full configuration*",
        "background_color": "transparent",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left"
      },
      "layout": { "x": 0, "y": 20, "width": 24, "height": 8 }
    }
  ]
}
