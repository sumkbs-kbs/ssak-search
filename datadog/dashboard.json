      "definition": {
        "title": "SSRF Attempts (24h)",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "formulas": [{ "formula": "query1" }],
            "queries": [
              {
                "name": "query1",
                "data_source": "logs",
                "query": "source:cloudflare service:$service @audit:\"true\" @eventType:\"ssrf_attempt\"",
