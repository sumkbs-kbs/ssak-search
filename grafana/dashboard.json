{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping /api/metrics",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_ANALYTICS",
      "label": "Analytics Engine (Simple JSON)",
      "description": "Simple JSON datasource pointing to /api/analytics-proxy for historical metrics",
      "type": "datasource",
      "pluginId": "grafana-simple-json-datasource"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.5.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "5.0.0" },
    { "type": "datasource", "id": "grafana-simple-json-datasource", "name": "Simple JSON", "version": "1.4.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "title": "Search Engine API — Monitoring",
  "description": "Cloudflare Workers-based search engine: backend health, latency, cache, error rates, and circuit breaker state",
  "tags": ["cloudflare", "workers", "search-engine", "prometheus", "analytics-engine"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["15s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Status",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Overall Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "description": "Aggregate system health based on backend statuses",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "avg(search_backend_status)",
          "legendFormat": "Health Score",
          "interval": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Total search requests processed",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "search_requests_total",
          "legendFormat": "Search Requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate (5m avg)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Error rate should be < 0.1% for 99.9% SLO",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.001 },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 0.1
        }
      },
      "targets": [
        {
          "expr": "search_error_ratio",
          "legendFormat": "Error Ratio",
          "interval": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Target: > 60% hit ratio",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "cache_hit_ratio",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Active Clients",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Active client IPs tracked (per-isolate, best-effort)",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "search_client_states_active",
          "legendFormat": "Active Clients",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Metrics Persistence",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Whether Analytics Engine persistence is active",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "search_metrics_persistence",
          "legendFormat": "Persistence Active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Backend Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 9,
      "title": "Backend Status Grid",
      "type": "stat",
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Individual backend health: 1=healthy, 0.5=degraded, 0=down",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "search_backend_status",
          "legendFormat": "{{host}}",
          "interval": "",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} }
      ]
    },
    {
      "id": 10,
      "title": "Circuit Breaker State",
      "type": "table",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Circuit breaker state per backend: 1=tripped (open)",
      "options": {
        "sortBy": [ { "displayName": "Value", "desc": true } ]
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none",
          "custom": {
            "align": "auto",
            "displayMode": "color-background"
          }
        }
      },
      "targets": [
        {
          "expr": "search_backend_circuit_tripped",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} }
      ]
    },
    {
      "id": 11,
      "title": "Request Volume & Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "collapsed": false
    },
    {
      "id": 12,
      "title": "Request Volume (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Request rate per endpoint (search, extract)",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "req/s",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "rate(search_requests_total[$__rate_interval])",
          "legendFormat": "search",
          "interval": "",
          "refId": "A"
        },
        {
          "expr": "rate(extract_requests_total[$__rate_interval])",
          "legendFormat": "extract",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "title": "Latency Distribution (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Search endpoint latency percentiles",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "s",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "search_latency_seconds{quantile=\"0.5\"}",
          "legendFormat": "p50",
          "interval": "",
          "refId": "A"
        },
        {
          "expr": "search_latency_seconds{quantile=\"0.95\"}",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "search_latency_seconds{quantile=\"0.99\"}",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 14,
      "title": "Extract Latency Distribution",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Extract endpoint latency percentiles",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "s",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "extract_latency_seconds{quantile=\"0.5\"}",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "extract_latency_seconds{quantile=\"0.95\"}",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "extract_latency_seconds{quantile=\"0.99\"}",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 15,
      "title": "Cache & Backend Failures",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "id": 16,
      "title": "Cache Performance (hits vs misses)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Cache hit/miss rate, tier breakdown, and hit ratio",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "ops/s",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "rate(cache_hits_total[$__rate_interval])",
          "legendFormat": "hits (total)",
          "refId": "A"
        },
        {
          "expr": "rate(cache_tier1_hits_total[$__rate_interval])",
          "legendFormat": "tier1 (edge)",
          "refId": "B"
        },
        {
          "expr": "rate(cache_tier2_hits_total[$__rate_interval])",
          "legendFormat": "tier2 (KV)",
          "refId": "C"
        },
        {
          "expr": "rate(cache_misses_total[$__rate_interval])",
          "legendFormat": "misses",
          "refId": "D"
        }
      ]
    },
    {
      "id": 17,
      "title": "Backend Failures",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Consecutive failure count per backend host",
      "options": {
        "displayMode": "basic",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "none",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "search_backend_failures",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} }
      ]
    },
    {
      "id": 18,
      "title": "In-flight Requests per Backend",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Current in-flight request count per backend host",
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "none",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "search_backend_inflight",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} }
      ]
    },
    {
      "id": 19,
      "title": "Error Rate Trends",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Error ratio over time for search and extract",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "unit": "percentunit",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "search_error_ratio",
          "legendFormat": "search",
          "refId": "A"
        },
        {
          "expr": "extract_error_ratio",
          "legendFormat": "extract",
          "refId": "B"
        }
      ]
    },
    {
      "id": 20,
      "title": "SLO & Alerts",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "SLO Compliance — 99.9% Availability",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Rolling 30-day availability vs 99.9% SLO target",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "unit": "percentunit",
          "min": 0.99,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "1 - (rate(search_errors_total[30d]) / (rate(search_requests_total[30d]) or vector(1)))",
          "legendFormat": "30-day Availability",
          "refId": "A"
        }
      ],
      "thresholds": [
        {
          "value": null,
          "op": "gt",
          "color": "green"
        },
        {
          "value": 0.999,
          "op": "lt",
          "color": "orange"
        },
        {
          "value": 0.99,
          "op": "lt",
          "color": "red"
        }
      ]
    },
    {
      "id": 22,
      "title": "Error Budget Remaining",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Error budget remaining for 99.9% SLO target (30-day window)",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "clamp_max(\n  (1 - (rate(search_errors_total[30d]) / (rate(search_requests_total[30d]) or vector(1))) - 0.999)\n  / (1 - 0.999) * 100,\n  100\n)",
          "legendFormat": "Budget Remaining",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "SLO Burn Rate (1h window)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "How fast error budget is being consumed. > 36 = critical burn (entire budget in 1h)",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 36 }
            ]
          },
          "unit": "none",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "(\n  rate(search_errors_total[1h])\n  /\n  (rate(search_requests_total[1h]) or vector(1))\n  /\n  (1 - 0.999)\n)",
          "legendFormat": "Burn Rate (1h)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "Quick Links",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "collapsed": false
    },
    {
      "id": 25,
      "title": "API Endpoints",
      "type": "table",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 50 },
