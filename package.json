{
  "name": "ssak-search",
  "version": "2.0.0",
  "description": "ssak-search \u2014 Tavily-compatible search engine API, no API keys required",
  "license": "MIT",
  "author": "Byungseok Kang <sumkbs@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mr.k/webapp"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:local": "bash scripts/deploy-local-worktree.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:all": "tsc --noEmit",
    "test": "vitest run --project unit",
    "start:local": "bash scripts/start-local.sh",
    "start:local:dev": "bash scripts/start-local.sh --dev",
    "start:local:no-ollama": "bash scripts/start-local.sh --no-ollama",
    "test:watch": "vitest --project unit",
    "test:all": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ci": "npm run test && npm run verify:bindings",
    "lint": "npm run typecheck 2>&1 | head -80 || true",
    "lint:ci": "npm run typecheck 2>&1",
    "lint:eslint": "eslint src/ tests/ scripts/ eval/ --max-warnings=0",
    "lint:eslint:ci": "eslint src/ tests/ scripts/ eval/ sdk/typescript --max-warnings=0",
    "lint:eslint:fix": "eslint src/ tests/ scripts/ eval/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'src/**/*.tsx' 'tests/**/*.ts' 'scripts/**/*.ts' 'eval/**/*.ts' '*.ts' '*.js'",
    "format:check": "prettier --check 'src/**/*.ts' 'src/**/*.tsx' 'tests/**/*.ts' 'scripts/**/*.ts' 'eval/**/*.ts' 'sdk/typescript/**/*.ts' '*.ts' '*.js'",
    "lint:fix": "npm run lint:eslint:fix && npm run format",
    "lint:todos": "node -e \"const c=require('fs').readFileSync(process.argv[1]||'/dev/null','utf8');const m=c.match(/\\b(TODO|FIXME|HACK|XXX)\\b/g);console.log((m?m.length:0)+' markers found')\" 2>/dev/null || echo '0 markers found'",
    "clean": "rm -rf dist/ .wrangler/ coverage/",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "verify:bindings": "npx tsx scripts/verify-do-binding.ts",
    "verify:index": "npx tsx scripts/verify-index.ts",
    "seed:index": "npx tsx scripts/seed-index.ts",
    "local:setup": "bash scripts/setup-local-indexing.sh",
    "local:index": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-index.py",
    "local:search": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-search.py",
    "local:stats": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-index.py --stats",
    "local:sync": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/sync-to-cloudflare.py",
    "local:index:all": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-index.py --category=all --limit=200",
    "local:v2:index": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-index-v2.py",
    "local:v2:search": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-search-v2.py",
    "local:v2:stats": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-search-v2.py --stats",
    "local:v2:index:all": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/local-index-v2.py --category=all --limit=200",
    "news:index": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/news-rss-scheduler.py",
    "news:index:dry": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/news-rss-scheduler.py --dry-run",
    "news:index:tech": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/news-rss-scheduler.py --category tech --limit=15",
    "news:index:kr": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/news-rss-scheduler.py --category kr --limit=15",
    "news:stats": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/news-rss-scheduler.py --stats",
    "news:cleanup": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/news-rss-scheduler.py --cleanup 7",
    "hybrid:search": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/hybrid-search.py",
    "hybrid:benchmark": "/Users/mr.k/miniforge3/envs/local-index/bin/python scripts/benchmark-hybrid.py",
    "eval": "npx tsx eval/index.ts",
    "eval:json": "npx tsx eval/index.ts --json",
    "eval:ci": "npx tsx eval/index.ts --ci --summary",
    "eval:ci:slack": "npx tsx eval/index.ts --ci-slack --summary",
    "eval:ci:save": "npx tsx eval/index.ts --ci --summary --save",
    "eval:median": "npx tsx eval/index.ts --runs 3 --json",
    "eval:median:save": "npx tsx eval/index.ts --runs 3 --json --save",
    "eval:median:ci": "npx tsx eval/index.ts --runs 3 --ci --summary",
    "eval:cache": "npx tsx eval/index.ts --cache",
    "eval:availability": "npx tsx scripts/report-backend-availability.ts",
    "eval:availability:hackernews": "npx tsx scripts/report-backend-availability.ts --backend hackernews",
    "eval:loss": "npx tsx scripts/analyze-429-loss.ts",
    "eval:drift": "npx tsx scripts/detect-gold-drift.ts",
    "eval:zero": "npx tsx scripts/probe-p1-zero.ts",
    "eval:general-zero": "npx tsx scripts/probe-general-zero.ts",
    "monitor:wiki-429": "npx tsx scripts/monitor-wiki-429.ts",
    "probe:academic": "npx tsx scripts/probe-academic-backends.ts",
    "probe:ds": "npx tsx scripts/probe-ds-routing.ts",
    "sim:academic-so": "npx tsx scripts/sim-academic-stackexchange.ts",
    "sim:academic-so-regression": "npx tsx scripts/sim-academic-so-regression.ts",
    "sim:rrf-ndcg": "npx tsx scripts/sim-rrf-ndcg.ts",
    "test:sdk:ts": "npx vitest run --project unit tests/unit/sdk-client.test.ts tests/unit/sdk-spec-consistency.test.ts",
    "test:sdk:python": "python3 -m unittest discover -s sdk/python/tests",
    "probe:ds-vocab": "npx tsx scripts/probe-ds-vocab.ts",
    "probe:deploy-vocab": "npx tsx scripts/probe-deploy-vocab.ts",
    "probe:en-tech-40": "npx tsx scripts/probe-en-tech-40-live.ts",
    "probe:openalex": "npx tsx scripts/probe-openalex.ts",
    "probe:ddg-202": "npx tsx scripts/probe-ddg-202.ts",
    "probe:bing-site": "npx tsx scripts/probe-bing-site.ts",
    "probe:ddg-zh": "npx tsx scripts/probe-ddg-zh.ts",
    "probe:searxng-zh": "npx tsx scripts/probe-searxng-zh.ts",
    "probe:wikipedia-budget": "npx tsx scripts/probe-wikipedia-budget.ts",
    "sim:fanout-latency": "npx tsx scripts/sim-fanout-latency.ts",
    "eval:s95delta": "npx tsx scripts/probe-s95-delta.ts",
    "probe:inmemory": "npx tsx scripts/probe-inmemory-bypass.ts",
    "eval:qps": "npx tsx eval/index.ts --json 2>/dev/null | jq '.report.qps' 2>/dev/null || npx tsx eval/index.ts 2>&1 | grep -E 'QPS|p50|p95|p99|Latency'",
    "eval:self": "npx tsx eval/index-self.ts",
    "eval:self:json": "npx tsx eval/index-self.ts --json",
    "eval:self:save": "npx tsx eval/index-self.ts --save",
    "eval:self:ci": "npx tsx eval/index-self.ts --ci --summary",
    "eval:self:tag": "npx tsx eval/index-self.ts --tag",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.67.0",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.17",
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/js": "^9.39.5",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.0",
    "ai": "^7.0.34",
    "comment-json": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
