# Scrapling Sidecar Configuration
# Copy this to .env and customize

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Naver Finance scraping
NAVER_FINANCE_TIMEOUT=15

# Scrapling settings
# Headless browser mode (true/false)
HEADLESS=true
# Cloudflare Turnstile solving (requires fetchers dependencies)
SOLVE_CLOUDFLARE=true
# Network idle timeout in seconds
NETWORK_IDLE_TIMEOUT=10
