// S104-③-⑤ (2026-08-11): staging variant of the deep-probe cron scheduler.
//
// Cloudflare Pages cannot host cron triggers, so each environment gets its own
// thin Workers script owning the `*/15 * * * *` trigger. The STAGING scheduler
// probes the staging Pages alias (https://staging.search-engine-api.pages.dev)
// so staging deep probes run automatically instead of depending on manual
// `?depth=full` calls. The production scheduler (wrangler.cron.jsonc) keeps
// pointing at the production domain — two separate Workers scripts, no var
// cross-contamination.
//
// Deploy (after the staging Pages deploy so PROBE_URL points at the newest bundle):
//   npx wrangler deploy --config wrangler.cron.staging.jsonc
// Tail its logs:
//   npx wrangler tail ssak-probe-scheduler-staging
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssak-probe-scheduler-staging",
  "main": "src/cron-probe.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  // Workers DO support cron triggers (Pages does not) — every 15 min.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "vars": {
    // The staging Pages alias this scheduler probes. Not a secret (public URL).
    "PROBE_URL": "https://staging.search-engine-api.pages.dev",
  },
}
