{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "search-engine-api",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  // S104-③-fix (2026-08-11): NO `triggers.crons` here — Cloudflare Pages does
  // NOT support cron triggers (Pages compatibility matrix: Cron Triggers
  // Workers ✅ / Pages ❌) and wrangler REJECTS the key for Pages config
  // ("Configuration file for Pages projects does not support \"triggers\""),
  // which BLOCKED `wrangler pages deploy`. The deep health probe is instead
  // scheduled by the separate Workers script `ssak-probe-scheduler`
  // (wrangler.cron.jsonc — a Workers config where triggers ARE valid), which
  // every 15 min invokes /api/health?depth=full on this deployment. That
  // route runs the shared deep probe (quota-burning) + Slack alerts and emits
  // the `[health] deep health probe complete` structured log.
  // Workers AI binding — free, auto-provisioned on all Cloudflare accounts.
  // Enables: answer generation (LLM), embedding generation (bge-base-en-v1.5),
  // and LLM reranking. Without this, all three fall back to degraded modes
  // (extractive answers, hash embeddings, heuristic reranking).
  "ai": { "binding": "AI" },
  // ── Phase 1: Self-index activation checklist ────────────────────────
  // The index layer (Vectorize + D1) is fully implemented in code but only
  // activates when both bindings resolve to real resources at runtime.
  // Status is visible at GET /api/health (index.configured + total_documents).
  //
  // Activation steps:
  //   1. Vectorize index (below) — create in Dashboard or via CLI:
  //        npx wrangler vectorize create search-engine-dense \
  //          --dimensions 768 --metric cosine
  //   2. D1 database (below) — create and capture the real UUID:
  //        npx wrangler d1 create search-engine-index
  //      Replace database_id: "auto" with the printed UUID.
  //   3. Deploy, then initialize the D1 schema:
  //        curl -X POST https://your.domain/api/index/init
  //   4. Seed the corpus (Wikipedia/GitHub/TechDocs + eval queries):
  //        npm run seed:index -- --api-url=https://your.domain --all
  //   5. Verify in /api/health: index.configured=true, total_documents > 0
  //
  // Without these, searchIndex()/hybridSearch() return [] and every query
  // falls back to live scraping (no millisecond response, no resilience).
  // ────────────────────────────────────────────────────────────────────

  // Vectorize index for dense vector search:
  // Cloudflare Dashboard → Workers & Pages → Vectorize → Create index
  // (name: search-engine-dense, dimensions: 768, metric: cosine)
  //
  // remote:true lets `wrangler pages dev` (local dev) talk to the REAL remote
  // Vectorize index — Vectorize does not support local simulation, so without
  // this flag local dev gets "not supported" and indexing/search no-ops.
  // Production deploys are unaffected (they always use the remote index).
  // Phase C.3: Semantic cache index — SEPARATE from the document index so
  // cached-query vectors never pollute document search results (and vice
  // versa: document chunks must not match as "similar queries").
  // Create it with the same model/dimensions as VECTORIZE_INDEX:
  //   npx wrangler vectorize create semantic-cache-dense \
  //     --dimensions 768 --metric cosine
  // Add the binding on Cloudflare Dashboard (Workers & Pages → Vectorize →
  // "semantic-cache-dense" → Add binding → name: SEMANTIC_CACHE_INDEX).
  // Without this binding, semanticCacheLookup()/semanticCacheStore() no-op —
  // the exact-match tiers keep working unchanged.
  "vectorize": [
    { "binding": "VECTORIZE_INDEX", "index_name": "search-engine-dense", "remote": true },
    { "binding": "SEMANTIC_CACHE_INDEX", "index_name": "semantic-cache-dense", "remote": true },
  ],
  // D1 database — create via Dashboard or CLI and set the real UUID:
  //   npx wrangler d1 create search-engine-index
  //   npx wrangler d1 list   (to look up the id)
  // "auto" only works for local dev; production needs a concrete database_id.
  // Then run schema: curl -X POST https://your.domain/api/index/init
  //
  // remote:true makes `wrangler pages dev` (local dev) talk to the REAL remote
  // D1 database. This is REQUIRED when Vectorize is also remote:true — otherwise
  // Vectorize (remote) returns chunk IDs that the local D1 doesn't know about,
  // and every search silently returns 0 results. Production deploys are
  // unaffected (always remote).
  "d1_databases": [
    {
      "binding": "SEARCH_INDEX_DB",
      "database_name": "search-engine-index",
      "database_id": "74e4966f-2496-491f-afbc-f26ffd109f25",
      "remote": true,
    },
  ],
  // Queue binding for async indexing (Phase 2.2):
  // Cloudflare Dashboard → Workers & Pages → Queues → Create queue
  // (name: search-index-queue)
  // "queues": [ { "binding": "INDEX_QUEUE", "queue": "search-index-queue" } ],
  // Durable Object bindings — P2 ④ (2026-08-10). Cloudflare Pages CANNOT
  // create Durable Objects within a Pages project, so the 11 DO classes are
  // deployed as a SEPARATE Workers script (wrangler.do.jsonc →
  // `ssak-do-worker`) and bound here via script_name. Deploy order:
  //   1. npx wrangler deploy --config wrangler.do.jsonc
  //   2. npx wrangler pages deploy   (this file)
  // Local dev: DO bindings are declared in wrangler.dev.jsonc instead
  // (resolved from the Pages entrypoint's exports — no script_name needed).
  "durable_objects": {
    // ⚠️ The 11-DO list lives in FOUR places — keep in sync when adding a DO:
    //    1. this file (script_name bindings)
    //    2. wrangler.do.jsonc (bindings + migrations)
    //    3. wrangler.dev.jsonc (exports + bindings)
    //    4. scripts/verify-do-binding.ts REQUIRED_DO_BINDINGS
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO", "script_name": "ssak-do-worker" },
      { "name": "THREAD_DO", "class_name": "ThreadDO", "script_name": "ssak-do-worker" },
      { "name": "PAGES_DO", "class_name": "PagesDO", "script_name": "ssak-do-worker" },
      { "name": "LIBRARY_DO", "class_name": "LibraryDO", "script_name": "ssak-do-worker" },
      { "name": "USER_PROFILE_DO", "class_name": "UserProfileDO", "script_name": "ssak-do-worker" },
      { "name": "SPACE_DO", "class_name": "SpaceDO", "script_name": "ssak-do-worker" },
      { "name": "API_KEY_DO", "class_name": "ApiKeyDO", "script_name": "ssak-do-worker" },
      { "name": "CRAWLER_DO", "class_name": "CrawlerDO", "script_name": "ssak-do-worker" },
      { "name": "CLICK_LOG_DO", "class_name": "ClickLogDO", "script_name": "ssak-do-worker" },
      { "name": "EXPERIMENT_DO", "class_name": "ExperimentDO", "script_name": "ssak-do-worker" },
      { "name": "CANARY_DO", "class_name": "CanaryOrchestratorDO", "script_name": "ssak-do-worker" },
      // ⚠️ v2 DO — DO 워커 마이그레이션 완료 후 활성화
      // { "name": "TENANT_AUDIT_DO", "class_name": "AuditLogDO", "script_name": "ssak-do-worker" },
      // { "name": "TENANCY_DO", "class_name": "TenancyDO", "script_name": "ssak-do-worker" },
      // { "name": "NEWS_HUB_DO", "class_name": "NewsHubDO", "script_name": "ssak-do-worker" },

    ],
  },
  // KV namespace for cross-restart cache persistence (Phase 5):
  // Hot queries persist across isolates and restarts (30 min TTL).
  // Cache.ts tier 2: Cache API miss → KV lookup → KV miss → live search.
  // Without this binding, cache is Cache API + in-memory only (per-isolate).
  //
  "kv_namespaces": [{ "binding": "CACHE_KV", "id": "1f5b3825e6a240a5b500d0f2faed15a8" }],

  // Workers Analytics Engine binding — persists metrics across isolate restarts.
  // Each record() in src/lib/metrics.ts calls ANALYTICS.writeDataPoint() so
  // search/extract latency + error rate survive cold starts and can be queried
  // via the Cloudflare Analytics Engine SQL API or visualized in Grafana.
  //
  // For local dev with `wrangler pages dev -c wrangler.dev.jsonc`:
  //   - Wrangler's local simulator supports Analytics Engine writes (writes
  //     are no-ops locally but the binding is present so record() succeeds).
  // For production Pages deploy:
  //   - Create the dataset in Dashboard (Workers & Pages → Analytics →
  //     Create dataset, name: SEARCH_API_METRICS).
  //   - Pages → ssak-search → Settings → Bindings → Workers Analytics
  //     Engine Datasets → Add binding (variable: ANALYTICS, dataset: above).
  //   - The dataset name below MUST match the created dataset.
  //   - To query historical data: see scripts/analytics-queries.sql.
  //
  // NOTE (2026-08-04): Analytics Engine enabled on account; dataset names must
  // use underscores only (hyphen "ssak-search" was rejected by deploy as
  // "Invalid dataset name"). Binding name ANALYTICS matches src/lib/metrics.ts.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "ssak_search" }],

  //
  // Sentry DSN (Phase 0.5) — error tracking and APM:
  // 1. Create a Sentry account at https://sentry.io/
  // 2. Create a new Cloudflare Workers project
  // 3. Copy the DSN from Settings → Client Keys (DSN)
  // 4. Set as Pages secret:
  //    npx wrangler pages secret put SENTRY_DSN
  // Without SENTRY_DSN, Sentry is a no-op (no errors, no traces).
  // tracesSampleRate=0.1 by default (10% of requests get performance traces).
  //
  // Scrapling Sidecar URL (Python FastAPI + Scrapling service for dynamic pages):
  // - Local dev: SIDECAR_URL=http://localhost:8000
  // - Production: npx wrangler pages secret put SIDECAR_URL
  // Without this, extractor.ts skips the sidecar fallback (uses Jina + HTMLRewriter only).
  // Install: see sidecar/README.md for Docker setup.
  //
  // Environment name (optional, default: 'production'):
  // npx wrangler pages secret put ENVIRONMENT
  //
  // For source maps in Sentry:
  // 1. Enable upload_source_maps in wrangler.jsonc or use @sentry/wizard
  // 2. npx @sentry/wizard@latest -i sourcemaps
  //
  // Logpush Job (for audit log retention beyond 7-day Live Tail):
  // 1. Cloudflare Dashboard → Logs & Analytics → Logs → Logpush → Add job
  //    Dataset: Workers logs (script_name="search-engine-api" OR field filter for audit events)
  // 2. Destination: R2 bucket OR HTTP endpoint (Datadog/Splunk/SIEM)
  // 3. Save → Activate (logs stream immediately)
  //
  // For multi-region deployment strategy, see AUDIT.md § "Multi-Region Strategy".
  //
  // ════════════════════════════════════════════════════════════════════════════
  // PRODUCTION BINDINGS — deployment checklist (P2 ④, 2026-08-10)
  // ════════════════════════════════════════════════════════════════════════════
  //
  // Durable Objects (11) are declared IN THIS FILE above, bound to the
  // separate `ssak-do-worker` script (wrangler.do.jsonc) via script_name.
  // The old "Dashboard-only" limitation is GONE — verified 2026-08-10:
  // `wrangler pages deploy` accepts durable_objects with a valid script_name.
  //
  // ┌──────────────────┬──────────────────┬─────────────────────────────────┐
  // │ Binding name     │ Class name       │ Feature that breaks if missing  │
  // ├──────────────────┼──────────────────┼─────────────────────────────────┤
  // │ RATE_LIMITER     │ RateLimiterDO    │ /api/search rate limiting       │
  // │ THREAD_DO        │ ThreadDO         │ /api/chat (multi-turn)          │
  // │ PAGES_DO         │ PagesDO          │ /api/pages (report storage)     │
  // │ LIBRARY_DO       │ LibraryDO        │ /api/library (collections)      │
  // │ USER_PROFILE_DO  │ UserProfileDO    │ /api/profile (personalization)  │
  // │ SPACE_DO         │ SpaceDO          │ /api/spaces (workspaces)        │
  // │ API_KEY_DO       │ ApiKeyDO         │ /api/keys (API key mgmt)        │
  // │ CRAWLER_DO       │ CrawlerDO        │ /api/crawl (URL ingestion)      │
  // │ CLICK_LOG_DO     │ ClickLogDO       │ LTR click/impression logging    │
  // │ EXPERIMENT_DO    │ ExperimentDO     │ /api/experiments (A/B testing)   │
  // │ CANARY_DO        │ CanaryOrchestratorDO │ /api/canary (parser regression) │
  // └──────────────────┴──────────────────┴─────────────────────────────────┘
  //
  // Step 1 — Deploy the DO host worker FIRST (required for the bindings
  //   above to validate):
  //     npx wrangler deploy --config wrangler.do.jsonc
  //   The DO classes live ONLY in `ssak-do-worker`; this Pages script merely
  //   holds namespace references (script_name bindings).
  //
  // Step 2 — R2 bucket (file uploads):
  //   1. Cloudflare Dashboard → R2 → Create bucket (e.g. "search-engine-uploads")
  //   2. Pages → search-engine-api → Settings → Bindings → R2 → Add binding
  //      (name: UPLOAD_BUCKET, bucket: search-engine-uploads)
  //   Without this: POST/GET /api/upload returns 501.
  //
  // Step 3 — INDEX_QUEUE (async indexing, Phase 2.2):
  //   1. Cloudflare Dashboard → Workers & Pages → Queues → Create queue
  //      (name: search-index-queue)
  //   2. Pages → search-engine-api → Settings → Bindings → Queues → Add binding
  //      (name: INDEX_QUEUE, queue: search-index-queue)
  //   Without this: indexing falls back to synchronous mode (slower but functional).
  //
  // Step 4 — Verify all bindings are active:
  //   export WORKER_URL="https://your-domain.pages.dev"
  //   bash scripts/verify-do-binding.sh
  //
  //   Expected output: 11 ✅ DO bindings + 1 ✅ R2 binding + 1 ✅ Queue binding
  //   If any 501 errors: missing binding above → return to Step 1/2/3.
  //
  // Local dev shortcut: wrangler.dev.jsonc declares ALL of the above so
  // `wrangler pages dev dist/ -c wrangler.dev.jsonc` works without Dashboard setup.
}
