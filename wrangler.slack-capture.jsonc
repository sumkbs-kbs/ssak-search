// S104-③-② 잔여 (2026-08-11): alert-capture worker — temporary webhook sink
// that logs alert POSTs so the production Slack-alert delivery path can be
// verified without a real Slack webhook.
//
// Deploy:
//   npx wrangler deploy --config wrangler.slack-capture.jsonc
// Tail its logs:
//   npx wrangler tail --config wrangler.slack-capture.jsonc ssak-alert-capture
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssak-alert-capture",
  "main": "src/slack-capture.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
}
